<odoo>
<menuitem id="menu_root" name="Procurement Auditor" groups="procurement_auditor.group_user"/>
<record id="view_providers_list" model="ir.ui.view"><field name="name">procurement.audit.provider.list</field><field name="model">procurement.audit.provider</field><field name="arch" type="xml"><tree><field name="name"/><field name="company_id"/><field name="mode"/><field name="model"/><field name="api_key_env"/><field name="allow_external"/><field name="quantity_tolerance"/><field name="price_tolerance"/><field name="total_tolerance"/></tree></field></record>
<record id="view_providers_form" model="ir.ui.view"><field name="name">procurement.audit.provider.form</field><field name="model">procurement.audit.provider</field><field name="arch" type="xml"><form><header></header><sheet><group><field name="name"/><field name="company_id"/><field name="mode"/><field name="model"/><field name="api_key_env"/><field name="allow_external"/><field name="quantity_tolerance"/><field name="price_tolerance"/><field name="total_tolerance"/></group></sheet></form></field></record>
<record id="action_providers" model="ir.actions.act_window"><field name="name">Extraction Providers</field><field name="res_model">procurement.audit.provider</field><field name="view_mode">tree,form</field></record><menuitem id="menu_providers" name="Extraction Providers" parent="menu_root" action="action_providers"/>
<record id="view_aliases_list" model="ir.ui.view"><field name="name">procurement.audit.alias.list</field><field name="model">procurement.audit.alias</field><field name="arch" type="xml"><tree><field name="company_id"/><field name="vendor_id"/><field name="vendor_sku"/><field name="product_id"/><field name="vendor_uom"/><field name="uom_id"/></tree></field></record>
<record id="view_aliases_form" model="ir.ui.view"><field name="name">procurement.audit.alias.form</field><field name="model">procurement.audit.alias</field><field name="arch" type="xml"><form><header></header><sheet><group><field name="company_id"/><field name="vendor_id"/><field name="vendor_sku"/><field name="product_id"/><field name="vendor_uom"/><field name="uom_id"/></group></sheet></form></field></record>
<record id="action_aliases" model="ir.actions.act_window"><field name="name">Vendor SKU and Unit Mappings</field><field name="res_model">procurement.audit.alias</field><field name="view_mode">tree,form</field></record><menuitem id="menu_aliases" name="Vendor SKU and Unit Mappings" parent="menu_root" action="action_aliases"/>
<record id="view_audits_list" model="ir.ui.view"><field name="name">procurement.audit.list</field><field name="model">procurement.audit</field><field name="arch" type="xml"><tree><field name="purchase_id"/><field name="company_id"/><field name="provider_id"/><field name="state"/><field name="attachment_id"/><field name="error"/><field name="review_note"/><field name="reviewer_id"/></tree></field></record>
<record id="view_audits_form" model="ir.ui.view"><field name="name">procurement.audit.form</field><field name="model">procurement.audit</field><field name="arch" type="xml"><form><header><button type="object" name="action_run" string="Audit Vendor Confirmation"/><button type="object" name="action_mark_reviewed" string="Mark Human Reviewed"/></header><sheet><group><field name="purchase_id"/><field name="company_id"/><field name="provider_id"/><field name="state"/><field name="attachment_id"/><field name="error"/><field name="review_note"/><field name="reviewer_id"/></group><group><field name="confirmation_text"/><field name="extracted"/><field name="usage"/><field name="provider_request_id"/><field name="order_fingerprint"/><field name="source_hash"/></group><field name="difference_ids"><tree create="0" edit="0" delete="0"><field name="kind"/><field name="vendor_sku"/><field name="expected"/><field name="observed"/><field name="note"/></tree></field></sheet></form></field></record>
<record id="action_audits" model="ir.actions.act_window"><field name="name">Confirmation Audits</field><field name="res_model">procurement.audit</field><field name="view_mode">tree,form</field></record><menuitem id="menu_audits" name="Confirmation Audits" parent="menu_root" action="action_audits"/>
</odoo>
